	<key>UIBackgroundModes</key><array><string>audio</string></array>
	<key>NSSupportsLiveActivities</key><true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key><true/>
	<key>CFBundleURLTypes</key><array><dict>
		<key>CFBundleURLName</key><string>com.hackathon.BinanceVoiceAgent</string>
		<key>CFBundleURLSchemes</key><array><string>binancevoice</string></array>
	</dict></array>
	<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><false/></dict>
</dict>
</plist>
